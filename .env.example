# Firebase web config — copy this file to .env and fill in the values
# from the Firebase Console (Project settings > Your apps > Web app).
# On Vercel, set the same names under Settings > Environment Variables
# (Production, Preview and Development). The app is Firebase-only:
# there is no local/demo mode and no VITE_DATA_MODE fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
