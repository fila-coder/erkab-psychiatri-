# local = development/test with localStorage (not production data)
# firebase = use your Firebase project (required for real Auth/Firestore testing)
VITE_DATA_MODE=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dedicated Google account applicants share Drive folders with
VITE_VERIFICATION_GOOGLE_ACCOUNT=

VITE_PAYMENT_PROVIDER=none
VITE_VIDEO_PROVIDER=none
